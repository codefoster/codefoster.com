---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { sortedPosts, hexoSlugize, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await sortedPosts();
  const groups = new Map<string, { name: string; posts: Post[] }>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const key = hexoSlugize(tag);
      const group = groups.get(key) ?? { name: tag, posts: [] };
      group.posts.push(post);
      groups.set(key, group);
    }
  }
  return [...groups.entries()].map(([tag, group]) => ({
    params: { tag },
    props: group,
  }));
}

const { name, posts } = Astro.props;
---

<Base title={`Tag: ${name}`} description={`Posts tagged ${name} on codefoster.com.`}>
  <header class="post-header">
    <h1>#{name}</h1>
    <div class="post-meta">
      {posts.length} posts · <a href="/tags/">all tags</a>
    </div>
  </header>
  <PostList posts={posts} />
</Base>

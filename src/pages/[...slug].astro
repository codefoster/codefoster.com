---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostMeta from '../components/PostMeta.astro';
import { sortedPosts, slug as postSlug, type Post } from '../lib/posts';
import { aliasRoutes } from '../lib/aliases';

// Posts and their legacy aliases both live at root-level paths, so one
// catch-all serves both: posts render the article, aliases render the
// same meta-refresh redirect page hexo-generator-alias produced.
export async function getStaticPaths() {
  const posts = await sortedPosts();
  const aliases = await aliasRoutes();
  return [
    ...posts.map((post) => ({
      params: { slug: postSlug(post) },
      props: { post },
    })),
    ...aliases.map(({ path, target }) => ({
      params: { slug: path },
      props: { redirectTo: target },
    })),
  ];
}

interface Props {
  post?: Post;
  redirectTo?: string;
}

const { post, redirectTo } = Astro.props;
const Content = post ? (await render(post)).Content : null;
const target = redirectTo && new URL(redirectTo, Astro.site).href;
---

{
  post && Content ? (
    <Base title={post.data.title} publishedDate={post.data.date}>
      <article>
        <header class="post-header">
          <h1>{post.data.title}</h1>
          <PostMeta post={post} />
        </header>
        <div class="prose">
          <Content />
        </div>
      </article>
    </Base>
  ) : (
    <html lang="en">
      <head>
        <meta charset="utf-8" />
        <title>Redirecting...</title>
        <link rel="canonical" href={target} />
        <meta http-equiv="refresh" content={`0; url=${target}`} />
        <meta name="robots" content="noindex" />
      </head>
      <body>
        <a href={target}>Click here if you are not redirected.</a>
      </body>
    </html>
  )
}

<script>
  import mediumZoom from 'medium-zoom';
  mediumZoom('.prose img', { background: 'rgba(6, 9, 8, 0.94)' });
</script>

---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { sortedPosts } from '../../lib/posts';

const posts = await sortedPosts();
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
const byYear = (year: number) => posts.filter((p) => p.data.date.getUTCFullYear() === year);
---

<Base title="Archives" description="Every post on codefoster.com since 2012.">
  <header class="post-header">
    <h1>Archives</h1>
    <div class="post-meta">{posts.length} posts since 2012</div>
  </header>
  {
    years.map((year) => (
      <section class="year-group">
        <h2 class="section-label" id={String(year)}>
          {year}/
        </h2>
        <PostList posts={byYear(year)} />
      </section>
    ))
  }
</Base>

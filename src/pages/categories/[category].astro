---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { sortedPosts, hexoSlugize, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await sortedPosts();
  const groups = new Map<string, { name: string; posts: Post[] }>();
  for (const post of posts) {
    const name = post.data.categories;
    const key = hexoSlugize(name);
    const group = groups.get(key) ?? { name, posts: [] };
    group.posts.push(post);
    groups.set(key, group);
  }
  return [...groups.entries()].map(([category, group]) => ({
    params: { category },
    props: group,
  }));
}

const { name, posts } = Astro.props;
---

<Base title={`Category: ${name}`} description={`Posts in the ${name} category on codefoster.com.`}>
  <header class="post-header">
    <h1>{name}/</h1>
    <div class="post-meta">
      {posts.length} posts · <a href="/categories/">all categories</a>
    </div>
  </header>
  <PostList posts={posts} showCategory={false} />
</Base>
